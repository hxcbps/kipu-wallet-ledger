{
  "name": "kipu-wallet-ledger",
  "version": "1.0.0",
  "private": true,
  "description": "Concurrency-safe wallet and double-entry ledger challenge",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit && serverless package",
    "dev": "serverless offline start",
    "db:migrate": "tsx scripts/migrate.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:all": "npm run test && npm run test:integration",
    "test:watch": "vitest --config vitest.config.mts",
    "stress": "tsx scripts/stress.ts",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "pg": "8.16.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/aws-lambda": "8.10.162",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "serverless": "3.40.0",
    "serverless-esbuild": "1.57.2",
    "serverless-offline": "13.10.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
